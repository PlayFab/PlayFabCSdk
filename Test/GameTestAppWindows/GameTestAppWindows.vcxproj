    <!-- Use the repo-built libHttpClient (Out\x64\$(Configuration)\libHttpClient.GDK.nosuffix)
         instead of the GDK's prebuilt Xbox.LibHttpClient extension. Without this,
         Xbox.Services.API.C\ExtensionLibrary.props auto-imports
         Xbox.LibHttpClient\libHttpClientLibrary.props, which prepends the GDK's LHC headers and
         injects libHttpClient.GDK.lib into the link. The app would then compile and bind against
         the GDK's older prebuilt LHC, so repo LHC changes would be untestable on PC. Must be set
         before the GDK extension props are imported. -->
    <LibHttpClientBuildFromSource>true</LibHttpClientBuildFromSource>
