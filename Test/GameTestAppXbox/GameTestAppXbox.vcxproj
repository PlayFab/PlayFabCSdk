xcopy /y /d "$(OutDir)libHttpClient.dll" "$(OutDir)libHttpClient.GDK.dll*"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\xgameruntime.dll" "$(OutDir)"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\GameChat2.dll" "$(OutDir)"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\Party.dll" "$(OutDir)"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\PartyXboxLive.dll" "$(OutDir)"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\PlayFabMultiplayer.dll" "$(OutDir)"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\XCurl.dll" "$(OutDir)"</Command>
