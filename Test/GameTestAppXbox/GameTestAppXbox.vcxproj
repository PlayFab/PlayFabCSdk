    <!-- - - - -->
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <TargetRuntime>Native</TargetRuntime>
    <!-- Xbox.LibHttpClient is deliberately NOT listed here, and LibHttpClientBuildFromSource
         is set below. That GDK extension ships a prebuilt libHttpClient.GDK.dll. Removing it
         from this list alone is NOT enough: Xbox.Services.API.C\ExtensionLibrary.props
         auto-imports Xbox.LibHttpClient\libHttpClientLibrary.props unless
         LibHttpClientBuildFromSource is set, which injects libHttpClient.GDK.lib into the link
         and prepends the GDK's LHC headers. The result was that the EXE's HCHttpCall* imports
         bound to the prebuilt DLL rather than the repo-built one, so libHttpClient changes were
         unreachable and untestable on console.

         Xbox.XCurl.API is also absent: GDK now uses the WinHTTP provider (see
         PlatformComponents_GDK.cpp), the Curl sources are no longer built for GDK, and nothing
         loads XCurl.dll. -->
    <GDKExtLibNames>Xbox.Services.API.C;Xbox.Game.Chat.2.Cpp.API;PlayFab.Multiplayer.Cpp;PlayFab.Party.Cpp;PlayFab.PartyXboxLive.Cpp</GDKExtLibNames>
    <!-- Use the repo-built libHttpClient (Out\x64\$(Configuration)\libHttpClient.GDK.nosuffix)
         instead of the GDK's prebuilt extension. Must be set before the GDK extension props
         are imported. -->
    <LibHttpClientBuildFromSource>true</LibHttpClientBuildFromSource>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
