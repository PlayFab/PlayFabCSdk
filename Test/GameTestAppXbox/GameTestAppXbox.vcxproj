    <LibraryPath>$(LibraryPath.Replace('10.0.19041.0','$(_FixedSDKVersion)'))</LibraryPath>
    <ExecutablePath>$(ExecutablePath.Replace('10.0.19041.0','$(_FixedSDKVersion)'))</ExecutablePath>
