<?xml version="1.0" encoding="utf-8"?>
<!--
  PC (Gaming.Desktop / x64) game config for PlayFabServicesTestApp.

  The Xbox devkit config (MicrosoftGame.Config) uses the PlayFabCommerceValidation identity, whose
  MSAAppId is not provisioned for the GDK desktop authentication stack. Using it on PC makes
  XUserAddAsync fail with E_GAMEUSER_INVALID_APP_CONFIGURATION (0x89245112), even when the loose
  layout is registered with "wdapp register".

  This config uses the XboxLiveE2E identity that the other PC GDK apps in this repo
  (GameTestAppWindows, PlayFabServicesManualTestApp, PlayFabGameSaveSample-Windows) already use,
  which is provisioned for XDKS.1 desktop auth.
-->
<Game configVersion="1">

  <Identity Name="41336MicrosoftATG.XboxLiveE2E" Publisher="CN=A4954634-DF4B-47C7-AB70-D3215D246AF1" Version="1.7.0.0" />

  <ExecutableList>
    <Executable Name="PlayFabServicesTestApp.GDK.exe"
                Id="Game"/>
  </ExecutableList>

  <MSAFullTrust>false</MSAFullTrust>
  <MSAAppId>000000004C26FED0</MSAAppId>
  <TitleId>76029B4D</TitleId>

  <PersistentLocalStorage>
    <SizeMB>1024</SizeMB>
  </PersistentLocalStorage>

  <ShellVisuals DefaultDisplayName="PlayFab Services Test App"
                PublisherDisplayName="Xbox ATG"
                Square150x150Logo="Assets\Logo.png"
                Square44x44Logo="Assets\SmallLogo.png"
                Description="PlayFab Services Test App"
                ForegroundText="light"
                BackgroundColor="#000040"
                SplashScreenImage="Assets\SplashScreen.png"
                StoreLogo="Assets\StoreLogo.png" />

  <DevelopmentOnly>
    <DebugNetworkPortList>
      <DebugNetworkPort>9000</DebugNetworkPort>
    </DebugNetworkPortList>
  </DevelopmentOnly>

</Game>
