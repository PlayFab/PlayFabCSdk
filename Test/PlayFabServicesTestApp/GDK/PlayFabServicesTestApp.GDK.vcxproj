  <!-- For x64 platform, use CustomBuild instead of MGCCompile since MGCCompile requires a Gaming.* toolchain.
       Without MicrosoftGame.config in $(OutDir) the app has no GDK title identity and XUserAddAsync fails.
       PC uses its own config: the Xbox devkit identity's MSAAppId is not provisioned for desktop auth. -->
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <CustomBuild Include="MicrosoftGame.PC.Config">
      <Command>copy /y "%(Identity)" "$(OutDir)MicrosoftGame.config"
makepkg.exe localize /d "$(OutDir)." /pd "$(OutDir)." /gc "%(Identity)" || ver >nul</Command>
      <Message>MGC Compile (x64)</Message>
      <Outputs>$(OutDir)MicrosoftGame.config</Outputs>
    </CustomBuild>
  </ItemGroup>
  <!-- For Gaming.Xbox.* and other GDK platforms, use MGCCompile with the devkit config -->
  <ItemGroup Condition="'$(Platform)'!='x64'">
    <MGCCompile Include="MicrosoftGame.Config" />
  </ItemGroup>
  <ItemGroup>
    <CopyFileToFolders Include="..\..\testTitleData.json">
      <FileType>Document</FileType>
    </CopyFileToFolders>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <PostBuildEvent>
      <Command>xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\XCurl.dll" "$(OutDir)"
xcopy /y /d "$(GameDKCoreLatest)windows\bin\x64\xgameruntime.dll" "$(OutDir)"</Command>
      <Message>Copying GDK extension library DLLs to output directory</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
