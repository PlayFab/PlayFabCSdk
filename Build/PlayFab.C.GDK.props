<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- This file is a replacement for Microsoft.Cpp.Default.Props and Microsoft.Cpp.props for Cpp projects targeting GDK -->

  <Import Condition="'$(PlayFabPathsImported)' != 'true'" Project="PlayFab.C.paths.props" />

  <!-- Fall back to GameDKLatest if GameDKCoreLatest is not set (older GDK command prompts) -->
  <PropertyGroup>
    <GameDKCoreLatest Condition="'$(GameDKCoreLatest)'==''">$(GameDKLatest)</GameDKCoreLatest>
    <LibHttpClientIncludeSuffix>false</LibHttpClientIncludeSuffix>
  </PropertyGroup>

  <!--Use same build config as LHC-->
  <Import Project="$(HCBuildRoot)\libHttpClient.GDK.props" />

  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(PlayFabSourceDir)\PlayFabGameSave\Include\GDK;%(AdditionalLibraryDirectories);</AdditionalLibraryDirectories>
    </Link>
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(PlayFabSourceDir)\PlayFabGameSave\Include\GDK;$(PlayFabSourceDir)\PlayFabGameSave\Include;$(PlayFabCoreGeneratedHeadersDir);$(PlayFabSourceDir)\PlayFabSharedInternal\Include;$(PlayFabSourceDir)\PlayFabSharedInternal\Include\Generated</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--Override build output directories-->
  <PropertyGroup>
    <OutDir>$(PlayFabOutRoot)\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</OutDir>
    <IntDir>$(PlayFabIntRoot)\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>

  <!-- Identify GDK builds for shared props conditions -->
  <PropertyGroup>
    <UseGDK>true</UseGDK>
    <HCPlatform>GDK</HCPlatform>
  </PropertyGroup>

  <!-- When using plain x64 platform, the GDK platform toolchain no longer sets _GAMING_DESKTOP automatically,
       links standard DirectX libraries, or resolves GDKExtLibNames include paths -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <IncludePath>$(GDKIncludeRoot)\playfab\multiplayer;$(GDKIncludeRoot)\playfab\party;$(IncludePath)</IncludePath>
    <!-- GDK 260400+ renamed the thunks lib; detect which name is available -->
    <XsapiThunksLib Condition="Exists('$(GDKLibPath)\Microsoft.Xbox.Services.C.Thunks.lib')">Microsoft.Xbox.Services.C.Thunks</XsapiThunksLib>
    <XsapiThunksLib Condition="'$(XsapiThunksLib)'==''">Microsoft.Xbox.Services.GDK.C.Thunks</XsapiThunksLib>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <ClCompile>
      <PreprocessorDefinitions>_GAMING_DESKTOP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d3d12.lib;dxgi.lib;dxguid.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Console platforms on the unified GDK layout (2510+, GDKCrossPlatform=true) no longer resolve
       GDKExtLibNames through GRDK\ExtensionLibraries, so the Party/Multiplayer headers under
       xbox\include\playfab\ are not on the include path. Their libs are already in xbox\lib\x64.
       These headers use the same config-struct API as PC, unlike the legacy console ExtensionLibrary
       headers; PF_GDK_UNIFIED_EXTLIB_LAYOUT lets callers pick the matching signatures, and
       PFGdkUnifiedExtLibLayout lets console projects add the link inputs ExtLibs used to supply. -->
  <PropertyGroup Condition="'$(Platform)'!='x64' AND '$(Platform)'!='ARM64' AND '$(GDKCrossPlatform)'=='true' AND Exists('$(DurangoXdkInstallPath)xbox\include\playfab\party')">
    <PFGdkUnifiedExtLibLayout>true</PFGdkUnifiedExtLibLayout>
    <IncludePath>$(DurangoXdkInstallPath)xbox\include\playfab\multiplayer;$(DurangoXdkInstallPath)xbox\include\playfab\party;$(IncludePath)</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(PFGdkUnifiedExtLibLayout)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>PF_GDK_UNIFIED_EXTLIB_LAYOUT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>